diff --git a/strix/core/identity/capture.py b/strix/core/identity/capture.py
index 3017df0..a3ae7e9 100644
--- a/strix/core/identity/capture.py
+++ b/strix/core/identity/capture.py
@@ -2,6 +2,7 @@
 
 from __future__ import annotations
 
+import os
 from datetime import UTC, datetime
 from typing import Any
 
@@ -23,12 +24,28 @@ _AUTH_HEADER_KEYS = frozenset(
 )
 
 
+def _extra_auth_header_keys() -> frozenset[str]:
+    """Extra identity-bearing header names, from ``STRIX_AUTH_HEADERS`` (comma-separated).
+
+    Some targets authenticate via a non-standard header the built-in set does not
+    recognize (e.g. a fixture that keys identity off ``X-User-Id``). Without this,
+    such headers are dropped during capture and every replayed identity looks the
+    same, so the differential harness sees no owner-vs-non-owner delta. Set
+    ``STRIX_AUTH_HEADERS=X-User-Id`` to include them. Empty/unset is a no-op.
+    """
+    raw = os.environ.get("STRIX_AUTH_HEADERS", "")
+    return frozenset(h.strip().lower() for h in raw.split(",") if h.strip())
+
+
 def _extract_auth_headers(headers: dict[str, str]) -> dict[str, str]:
     """Pick out auth-bearing headers from a captured request."""
+    extra = _extra_auth_header_keys()
     return {
         k: v
         for k, v in headers.items()
-        if k.lower() in _AUTH_HEADER_KEYS or any(token in k.lower() for token in ("token", "auth"))
+        if k.lower() in _AUTH_HEADER_KEYS
+        or k.lower() in extra
+        or any(token in k.lower() for token in ("token", "auth"))
     }
 
 
diff --git a/strix/core/identity/store.py b/strix/core/identity/store.py
index 0955c74..cecba65 100644
--- a/strix/core/identity/store.py
+++ b/strix/core/identity/store.py
@@ -44,6 +44,10 @@ class IdentityStore:
         self.db_path = db_path
         db_path.parent.mkdir(parents=True, exist_ok=True)
         self._conn: sqlite3.Connection = sqlite3.connect(str(db_path), check_same_thread=False)
+        # Defense in depth against concurrent writers (the agent dispatches tools in
+        # parallel): wait up to 5s for the write lock instead of failing immediately
+        # with "database is locked". The tools-layer _STORE_LOCK is the primary guard.
+        self._conn.execute("PRAGMA busy_timeout = 5000")
         self._conn.row_factory = sqlite3.Row
         self._conn.executescript(_SCHEMA_SQL)
         self._conn.commit()
diff --git a/strix/tools/identity/tools.py b/strix/tools/identity/tools.py
index efb523d..78dce4b 100644
--- a/strix/tools/identity/tools.py
+++ b/strix/tools/identity/tools.py
@@ -7,6 +7,7 @@ redacted; raw values live only inside the SQLite store.
 
 from __future__ import annotations
 
+import asyncio
 import json
 import logging
 from pathlib import Path
@@ -32,6 +33,13 @@ if TYPE_CHECKING:
 
 logger = logging.getLogger(__name__)
 
+# Serialize identity-store access. The store is a single SQLite file per run,
+# opened/closed per call; the strix agent dispatches tools in parallel, so
+# concurrent upserts collide on the SQLite write lock ("database is locked") —
+# in practice most fail while one wins. A process-level async lock makes store
+# operations mutually exclusive (one identity store per engagement).
+_STORE_LOCK = asyncio.Lock()
+
 
 _CVSS_IDOR: dict[str, str] = {
     "attack_vector": "N",
@@ -240,11 +248,12 @@ async def _run_auth_matrix(
     run_dir: Path,
 ) -> dict[str, Any]:
